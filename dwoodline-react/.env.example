# Base path for production builds. "/" for a domain root, "/dwoodline/" for
# GitHub Pages project hosting. Consumed by vite.config.ts.
VITE_BASE_PATH=/

# Inquiry form submission endpoint. When empty, the inquiry service falls back
# to the original client-only confirmation behavior (no network request).
VITE_INQUIRY_ENDPOINT=

# Optional analytics measurement id. When empty, analytics is disabled.
VITE_ANALYTICS_ID=
